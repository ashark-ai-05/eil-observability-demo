{
  "name": "eil-observability-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "check": "pnpm test && pnpm demo:validate && pnpm demo:test",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "demo:validate": "node scripts/validate-foundation.mjs",
    "demo:reset": "node scripts/demo-runner.mjs reset",
    "demo:run": "node scripts/demo-runner.mjs run",
    "demo:replay": "node scripts/demo-runner.mjs replay",
    "demo:test": "node scripts/demo-runner.mjs all",
    "cockpit": "node scripts/cockpit-server.mjs",
    "amp:probe": "node scripts/amp-probe.mjs",
    "test:integration": "node --test integration/*.test.mjs",
    "report": "node scripts/report.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
