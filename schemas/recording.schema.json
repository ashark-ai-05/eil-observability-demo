{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.local/schemas/recording.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "recordingId", "runnerKind", "capturedAt", "scenarioDigest", "runnerDigest", "receiptDigests", "artifactDigests", "acceptanceResultDigest"],
  "properties": {
    "apiVersion": { "const": "eil-observability-demo/v1alpha1" }, "kind": { "const": "Recording" },
    "recordingId": { "$ref": "common.schema.json#/$defs/identifier" },
    "runnerKind": { "enum": ["amp_cli", "copilot_cli", "maas_reference"] },
    "capturedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "scenarioDigest": { "$ref": "common.schema.json#/$defs/digest" }, "runnerDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "receiptDigests": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/digest" } },
    "artifactDigests": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/digest" } },
    "acceptanceResultDigest": { "$ref": "common.schema.json#/$defs/digest" }
  }
}
